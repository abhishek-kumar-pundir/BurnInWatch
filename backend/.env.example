# Copy to .env (backend/.env). All settings are optional.
BURNINWATCH_LOG_LEVEL=INFO
BURNINWATCH_DEFAULT_MODEL=response_focused
BURNINWATCH_MODELS_DIR=models
BURNINWATCH_PRELOAD_MODELS=false
BURNINWATCH_MAX_UPLOAD_MB=25
# Comma-separated or JSON list
BURNINWATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
